# 频道运营 Bot 环境变量。复制为 .env.local 后填写；.env.local 不入库。

# 必填：运营 Bot 的 token（在 @BotFather 新建，不要复用前台 Bot 或 Web 只读 Bot）
OPS_BOT_TOKEN=

# 必填：owner 的 Telegram 数字 ID
OWNER_ID=

# 必填：管理员数字 ID，逗号分隔；owner 会自动并入
ADMIN_IDS=

# 必填：预告频道，-100... 或 @username（用于发帖与统计）
PREVIEW_CHANNEL_ID=

# 访客菜单：公开链接（未填时对应按钮禁用/隐藏）
PREVIEW_CHANNEL_URL=
BACKUP_CHANNEL_URL=
BACKUP_CHANNEL_ID=
ONLYFANS_URL=
CONTACT_BOT_URL=

# X 轮询开关：X 未充值或暂不测试时设为 0
X_ENABLED=1

# X_ENABLED=1 时必填：X API 凭据（复用 Web 的或单独申请）
X_BEARER_TOKEN=
X_USERNAME=

# 选填
POLL_MINUTES=5
APPROVAL_TTL_HOURS=24
BACKFILL_COUNT=0

# 报表：HH:MM 或留空关闭；周报格式 MON 10:00
REPORT_DAILY=10:00
REPORT_WEEKLY=MON 10:00
DATABASE_PATH=./data/ops-bot.sqlite
TIMEZONE=Asia/Shanghai

# 仅测试用
# API_ROOT=http://127.0.0.1:8081
# X_API_ROOT=http://127.0.0.1:8082
