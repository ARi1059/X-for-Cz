{
  "name": "godfather-ops-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "教父频道运营 Bot：X 新帖先审后发、频道成员统计与管理员报表",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check": "npm run typecheck && npm test",
    "doctor": "tsx src/doctor.ts"
  },
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
