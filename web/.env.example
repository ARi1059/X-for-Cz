# Local development example. npm run setup generates independent local secrets.
# Use HTTPS APP_ORIGIN and persistent absolute paths when preparing deployment.
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./var/site.sqlite
MEDIA_ROOT=./var/media
# Optional: development + loopback HTTP only; show the current saved draft at /.
# Production always reads published content, including when this flag is set.
LOCAL_DRAFT_PREVIEW=0
# Fixed contract limits: age 30 days; admin 8 hours; upload 10 MiB;
# image 24 million pixels / 6000px; media storage 500 MiB.
AGE_SIGNING_SECRET=
SESSION_HASH_SECRET=
# Never commit real credentials or the generated .env.local file.

# Story Lab 数据（服务端读取，写入 .env.local，不要提交）
# 未配置时：生产环境显示「实时数据暂不可用」，开发环境保留标记为“示例”的演示数据。
# X API v2 bearer token；X_USERNAME 填不带 @ 的账号名。
# 免费套餐通常只能读账号指标，读不了时间线；读不到帖子时只显示粉丝数。
X_BEARER_TOKEN=
X_USERNAME=
# Telegram Bot API 只用来读取频道人数。建议单独建一个只加入频道的 Bot，
# 不要把前台 Bot 的 token 复制到网站；Bot 必须能访问对应频道。
# 频道可填 @username、https://t.me/username 或 -100... 数字 ID。
TELEGRAM_BOT_TOKEN=
TELEGRAM_ANTI_LOSS_CHAT=
TELEGRAM_PREVIEW_CHAT=
# 服务端缓存秒数，30–3600，默认 300。X 读额度紧张时可调大。
STORY_FEED_TTL_SECONDS=300
